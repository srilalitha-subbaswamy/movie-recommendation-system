# =============================================================================
# Movie Recommendation System - Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=recsys
POSTGRES_PASSWORD=changeme
POSTGRES_DB=movie_recsys
DATABASE_URL=postgresql+asyncpg://recsys:changeme@localhost:5433/movie_recsys

# Redis
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# API
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Models
ALS_MODEL_PATH=models/als
NCF_MODEL_PATH=models/ncf.onnx

# TMDB (get free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
JWT_SECRET=change-me-in-production

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Frontend (set in Vercel for production)
# VITE_API_URL=https://your-api.up.railway.app
